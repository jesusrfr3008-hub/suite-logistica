# (carpetas) o viven en la base de datos (Postgres), no en estos archivos.
data/logistica.db
data/documentos/
data/documentos_gastos/
data/documentos_legajo/
data/pdf_oc/

# Los logos de las empresas compradoras (data/logos_empresas/) SI se suben
